<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/revox_pictogram_title">

    <com.android.settingslib.widget.TopIntroPreference
        android:key="pictogram_intro"
        android:title="@string/pictogram_intro"/>

    <PreferenceCategory>
        <SwitchPreferenceCompat
            android:key="pictogram_4g_for_lte"
            android:title="@string/pictogram_4g_for_lte_title"
            android:summary="@string/pictogram_4g_for_lte_summary"
            android:persistent="false"
            android:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            android:key="pictogram_4g_for_3g"
            android:title="@string/pictogram_4g_for_3g_title"
            android:summary="@string/pictogram_4g_for_3g_summary"
            android:persistent="false"
            android:iconSpaceReserved="false"/>

        <SwitchPreferenceCompat
            android:key="pictogram_hide_lte_plus"
            android:title="@string/pictogram_hide_lte_plus_title"
            android:summary="@string/pictogram_hide_lte_plus_summary"
            android:persistent="false"
            android:iconSpaceReserved="false"/>

        <ListPreference
            android:key="pictogram_5g_style"
            android:title="@string/pictogram_5g_title"
            android:entries="@array/pictogram_5g_entries"
            android:entryValues="@array/pictogram_5g_values"
            android:dialogTitle="@string/pictogram_5g_title"
            android:persistent="false"
            app:useSimpleSummaryProvider="true"
            android:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pictogram_icons_category">
        <Preference
            android:key="pictogram_icon_3g"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_3g+"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_4g"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_4g+"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_lte"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_lte+"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_5g"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_5g+"
            android:persistent="false"/>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pictogram_signal_category">
        <Preference
            android:key="pictogram_icon_s0"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_s1"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_s2"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_s3"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_s4"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_airplane"
            android:persistent="false"/>
        <Preference
            android:key="pictogram_icon_satellite"
            android:persistent="false"/>
    </PreferenceCategory>
</PreferenceScreen>
